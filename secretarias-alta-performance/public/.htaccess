# Regras para hospedagem em Apache/LiteSpeed (Hostinger). Copiado para a raiz do site no export.

# HTTPS sempre
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Página de erro
ErrorDocument 404 /404.html

# Tipos
AddType video/mp4 .mp4
AddType font/woff2 .woff2
AddCharset UTF-8 .html .css .js .json .xml .txt

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache
<IfModule mod_headers.c>
  # arquivos do build têm hash no nome: podem ficar em cache por 1 ano
  SetEnvIf Request_URI "^/_next/static/" IMMUTABLE_ASSET
  Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE_ASSET
  # imagens, fontes e vídeo: 7 dias
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|woff2|mp4)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # HTML sempre revalidado (o deploy troca o conteúdo)
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Não listar pastas
Options -Indexes
